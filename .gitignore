# =========================================================
# NEBLI -- .gitignore (canonico 2026-05-22)
# Versiona codigo do pipeline + decisoes + banco em .md.
# Ignora conteudo gerado, materia-prima bruta e arquivos pesados.
# =========================================================

# ---- Segredos e config local de maquina (NUNCA versionar) ----
# settings.local.json guarda chaves de API e permissoes locais do Claude Code.
.claude/settings.local.json
**/settings.local.json
*.env
.env
.git-credentials

# ---- Artefatos grandes regeneraveis / com copyright (add 2026-07-10) ----
flashcards/scripts/anking-v12-export.txt
pequenos_ajustes/Introdução à economia - Mankiw.pdf
pequenos_ajustes/*.pdf

# ---- Conteudo gerado pelo pipeline ----
resumos-gerados/
typst-build/*.pdf
typst-build/_par_*/*.pdf
typst-build/_par_*/main.typ
typst-build/_thumbs/
typst-build/_cadernos/
typst-build/__pycache__/
**/__pycache__/
*.pyc

# ---- Materia-prima bruta (nao versionavel) ----
_material/
slides/**/*.pdf
slides/**/*.png
slides/**/*.jpg
slides/**/*.jpeg
Inspiração de FORMA/
NEBLIcards/
plataforma/
material_ligas/

# ---- Arquivos gigantes (fotos/scans/pdfs antigos) ----
resumos_antigos/
anti-processo/
lixo/

# ---- Figuras dos resumos (PNGs extraidos dos slides, ~3 GB) ----
# Versiona so os MAPA_CONTEUDO.txt (texto pequeno, util pra reproduzir).
figuras/**/*.png
figuras/**/*.jpg
figuras/**/*.jpeg
figuras/**/*.svg
!figuras/**/MAPA_CONTEUDO.txt
!figuras/**/MAPA_CONTEUDO.md

# ---- Figuras do banco (PNGs de questoes, ~107 MB) ----
banco/figuras/

# ---- Transientes do orquestrador ----
arquivos-trabalho/tema-cards/
arquivos-trabalho/relatorios/
arquivos-trabalho/observacao_tokens.md
arquivos-trabalho/*.tmp
arquivos-trabalho/_arquivo-figuras-legadas/
arquivos-trabalho/**/*.png
arquivos-trabalho/**/*.jpg
arquivos-trabalho/**/*.jpeg
arquivos-trabalho/**/*.pdf

# ---- Backups (vivem em outro lugar; git ja eh backup) ----
backups/tecnicos/
backups/operacoes-fechadas/

# ---- Sistema / editor ----
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
.vscode/
.idea/

# ---- Logs e caches de Typst ----
*.log
.typst-cache/

# ---- Estado local do orquestrador NEBLI ----
state/
artifacts/
config/nebli.local.yaml

# ---- Pacotes, coleções e estado pessoal: fora do GitHub público ----
*.apkg
*.colpkg
*.anki2
*.anki21
*.anki21b
*.sqlite
config/publicacoes-uc.json
arquivos-trabalho/**/catalogo*.json
arquivos-trabalho/**/preflight*.json
arquivos-trabalho/**/publication.json
arquivos-trabalho/**/DOCS-ORIGINAL.txt

# Livros do curso baixados localmente e capítulos extraídos (direitos autorais; nunca versionar)
arquivos-trabalho/livros/

# Snapshot pessoal da amostra de retenção; resumo público fica em flashcards/projeto.
arquivos-trabalho/calibracao-retencao-2026-09-25/*.json
arquivos-trabalho/calibracao-retencao-2026-09-25/*.jsonl

# Dados de deck das corridas (snapshots, inventários, planos, recibos, textos extraídos de slide/prova/vídeo):
# conteúdo de cards AnKing e material docente; ficam só na máquina (auditoria 25/09: "não fazer push dos snapshots").
# Scripts (.py), relatórios (.md) e fontes Typst das corridas continuam versionados.
arquivos-trabalho/**/*.json
arquivos-trabalho/**/*.jsonl
arquivos-trabalho/**/*.txt
arquivos-trabalho/**/*.vtt
arquivos-trabalho/**/*.tsv
arquivos-trabalho/**/*.html
arquivos-trabalho/**/*.patch
arquivos-trabalho/**/*.lock
# Revisão visual de PDF (PNGs de página) e cópias locais de E1
typst-build/_par_*/revisao/
typst-build/_par_*/*.pdf
arquivos-trabalho/**/slide-texto.md
