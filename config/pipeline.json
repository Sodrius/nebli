{
  "pipeline_version": "e1-deck-v8",
  "generate_e1": true,
  "generate_resumindo": true,
  "generate_e2": false,
  "generate_e3": false,
  "generate_remnote": false,
  "anki_backend": "ankidroid",
  "normal_flow_desktop_fallback": false,
  "emergency_desktop_fallback_only_if_explicitly_requested": true,
  "ankidroid": {
    "manifest_schema": "nebli-ankidroid-deck-v3",
    "legacy_manifest_schemas": ["nebli-ankidroid-lesson-v2", "nebli-ankidroid-v1"],
    "full_deck_direct_install": true,
    "resolution_mode": "local_decks_with_validated_fallbacks",
    "anking_direct_copy": true,
    "anking_source_filter": "deck:\"AnKing Step Deck\"",
    "external_deck_direct_copy": true,
    "authored_direct_install": true,
    "authored_extra_media_direct_install": true,
    "image_occlusion_direct_install": true,
    "self_contained_new_media": true,
    "new_media_require_source_credit": true,
    "open_ankidroid_after_install": true,
    "select_target_deck_after_install": true,
    "write_prefix": "NEBLI::",
    "optional_subdeck_suffix": "::Optional",
    "preserve_source_note_type": true,
    "preserve_source_fields": true,
    "preserve_source_tags": true,
    "preserve_media_refs": true,
    "reset_scheduling": true,
    "selected_sibling_policy": "suspend_unselected",
    "mutate_source": false,
    "rollback_new_notes_on_partial_failure": true,
    "require_install_receipt": true,
    "require_installed_equals_expected": true,
    "ranking": {
      "min_score": 0.82,
      "min_margin": 0.06,
      "max_candidates": 80,
      "prefer_anking": true,
      "require_anking_marker_for_anking_source": true,
      "source_filter_is_hint": true,
      "separate_note_context_from_expected_answer": true,
      "direct_authored_requires_completed_anking_search": true,
      "external_deck_may_use_source_filter": true,
      "ambiguous_policy": "use_validated_fallback"
    },
    "final_validation": {
      "mode": "every_card",
      "required_pass_fraction": 1.0,
      "require_expected_equals_validated": true,
      "require_installed_equals_validated": true,
      "block_on_any_failure": true,
      "validator": "flashcards/scripts/validar_deck_card_a_card.py",
      "ci_reference_deck_size": 40
    },
    "release_gate": {
      "schema": "nebli-e1-deck-release-v1",
      "required": true,
      "require_reviewed_e1_source_and_pdf_hashes": true,
      "require_complete_nuclear_coverage": true,
      "minimum_nuclear_coverage_quality": 2,
      "require_every_card_linked_to_e1_concept": true,
      "require_independent_e1_review": true,
      "block_unresolved_core_omissions": true,
      "block_unresolved_ambiguities": true
    }
  },
  "require_offline_apkg": false,
  "require_apkg_audit": false,
  "require_e1_anchor_for_every_card": true,
  "source_priority": ["anking", "external_deck", "authored"],
  "non_anking_requires": {
    "completed_anking_search": true,
    "minimum_independent_queries": 3,
    "expanded_scope": true,
    "siblings_reviewed": true,
    "candidate_count_recorded": true,
    "candidate_rejections_recorded": true
  },
  "card_quality_contract": "docs/canon/CARD-QUALITY.md",
  "card_budget": {
    "enforce_contract_hard_max": true,
    "sanity_ranges": {
      "small": [15, 25],
      "medium": [25, 40],
      "large": [35, 55]
    },
    "manual_review_above": 60
  },
  "authored_cards": {
    "front_language": "en",
    "extra_language": "pt-BR",
    "retrievals_per_card": 1,
    "cloze_occurrences_per_card": 1,
    "cloze_index": 1,
    "max_front_characters": 360,
    "max_extra_words": 100,
    "extra_images_require_cognitive_purpose": true,
    "extra_images_require_source_credit": true
  },
  "cloze_answer_words": {
    "preferred": 1,
    "allowed": 2,
    "exceptional": 3,
    "hard_max": 3,
    "require_reason_for_three": true
  },
  "image_occlusion": {
    "multi_label_mode": "hide_all_guess_all",
    "mask_answer_label_not_visual_target": true,
    "require_coherent_set_for_multiple_masks": true,
    "require_question_and_answer_previews": true,
    "require_real_source": true,
    "require_source_credit": true,
    "block_answer_leak": true
  },
  "new_cards_per_day": 25,
  "maximum_reviews_per_day": 9999,
  "optional_cards_separate": true,
  "user_delivery": {
    "finalizer": "flashcards/scripts/finalizar_entrega_canonica.py",
    "visible_files": ["e1_pdf", "ankidroid_manifest"],
    "hide_internal_work_artifacts": true,
    "manifest_open_starts_install_automatically": true,
    "open_ankidroid_after_install": true,
    "manual_card_selection": false
  }
}
