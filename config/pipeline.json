{
  "pipeline_version": "e1-deck-v5",
  "generate_e1": true,
  "generate_resumindo": true,
  "generate_e2": false,
  "generate_e3": false,
  "generate_remnote": false,
  "anki_backend": "ankidroid",
  "anki_backend_fallback": "desktop",
  "ankidroid": {
    "manifest_schema": "nebli-ankidroid-lesson-v2",
    "legacy_manifest_schema": "nebli-ankidroid-v1",
    "resolution_mode": "concepts_local",
    "write_prefix": "NEBLI::",
    "copy_mode": "exact_fields",
    "preserve_note_type": true,
    "preserve_media_refs": true,
    "reset_scheduling": true,
    "selected_sibling_policy": "suspend_unselected",
    "mutate_source": false,
    "require_install_receipt": true,
    "ranking": {
      "min_score": 0.82,
      "min_margin": 0.06,
      "max_candidates": 80,
      "prefer_anking": true,
      "require_anking_marker": false,
      "ambiguous_policy": "leave_unresolved"
    }
  },
  "require_offline_apkg": false,
  "require_apkg_audit": false,
  "desktop_fallback_require_offline_apkg": true,
  "desktop_fallback_require_apkg_audit": true,
  "require_e1_anchor_for_every_card": true,
  "source_priority": ["anking", "external_deck", "authored"],
  "card_budget": {
    "enforce_contract_hard_max": true,
    "sanity_ranges": {
      "small": [15, 25],
      "medium": [25, 40],
      "large": [35, 55]
    },
    "manual_review_above": 60
  },
  "cloze_answer_words": {
    "preferred": 1,
    "allowed": 2,
    "exceptional": 3,
    "hard_max": 3
  },
  "image_occlusion": {
    "multi_label_mode": "hide_all_guess_all",
    "mask_answer_label_not_visual_target": true,
    "require_question_and_answer_previews": true
  },
  "new_cards_per_day": 25,
  "maximum_reviews_per_day": 9999,
  "optional_cards_separate": true
}
