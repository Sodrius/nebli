{
  "pipeline_version": "e1-deck-v13",
  "card_source_mode": "authored_only",
  "generate_e1": true,
  "generate_resumindo": true,
  "generate_e2": false,
  "generate_e3": false,
  "generate_remnote": false,
  "anki_backend": "apkg",
  "normal_flow_desktop_fallback": false,
  "anking": {
    "status": "suspended",
    "preserve_infrastructure": false,
    "allow_runtime_lookup": false,
    "require_search_before_authorship": false,
    "allow_source_copy": false
  },
  "external_decks": {
    "status": "suspended"
  },
  "learning_delta": {
    "authority": "FLASHCARDS.md",
    "inputs": ["lesson_materials", "e1", "master_sheet"],
    "forbid_prior_deck_lookup": true,
    "require_whole_lesson_read_before_cards": true,
    "require_master_sheet_context": true,
    "eligible_roles": ["foco_novo", "relacao_nova", "aprofundamento_novo"],
    "non_card_roles": ["pre_requisito", "revisao", "contexto", "exemplo", "mencao"],
    "require_positive_teaching_evidence": true,
    "require_lesson_gain_for_card_eligible_concepts": true,
    "validator": "flashcards/scripts/validar_ganho_aula.py"
  },
  "source_priority": ["authored", "io"],
  "require_offline_apkg": true,
  "require_apkg_audit": true,
  "require_e1_anchor_for_every_card": true,
  "card_budget": {
    "enforce_contract_hard_max": true,
    "freeze_retrieval_slots_before_authorship": true,
    "estimated_seconds_per_card_max": 10,
    "sanity_ranges": {
      "small": [8, 12],
      "medium": [12, 18],
      "large": [18, 22]
    },
    "default_hard_max": {
      "small": 15,
      "medium": 20,
      "large": 25
    },
    "manual_review_above": 25,
    "retention_classes": ["must_recall", "derivable", "e1_only", "optional"],
    "require_declared_hard_max": true,
    "forbid_hard_max_derived_from_card_count": true,
    "require_ablation_contract_per_card": true,
    "ablation_contract_fields": ["memory_gain", "ablation_loss", "why_not_e1_only", "confusion_target"]
  },
  "authored_cards": {
    "accepted_sources": ["authored", "io"],
    "language": "pt-BR",
    "retrievals_per_card": 1,
    "cloze_occurrences_per_card": 1,
    "cloze_index": 1,
    "max_front_characters": 360,
    "max_extra_words": 100,
    "all_images_require_didactic_value_review": true
  },
  "cue_quality": {
    "applies_to_every_authored_card": true,
    "require_medical_knowledge": true,
    "block_grammar_only_answer": true,
    "block_lexical_leak": true,
    "block_answer_visible_elsewhere": true,
    "require_zero_unresolved_plausible_alternatives": true,
    "block_abstract_answer": true,
    "block_answer_with_alternatives": true,
    "require_answer_present_in_e1_anchor": true,
    "block_discriminator_only_in_extra": true,
    "require_derivation_rationale_for_duplicate_retrieval": true
  },
  "cloze_answer_words": {
    "preferred": 1,
    "allowed": 2,
    "exceptional": 3,
    "hard_max": 3,
    "require_reason_for_three": true
  },
  "image_occlusion": {
    "multi_label_mode": "hide_two_guess_two",
    "prompt_language": "pt-BR",
    "answers_language": "pt-BR",
    "minimum_masks_per_card": 1,
    "maximum_masks_per_card": 2,
    "require_pair_rationale_for_two_masks": true,
    "mask_answer_label_not_visual_target": true,
    "require_question_and_answer_previews": true,
    "require_real_source": true,
    "require_source_credit": true,
    "block_answer_leak": true,
    "require_cognitive_purpose": true,
    "max_crop_ratio_of_slide": 0.9
  },
  "new_cards_per_day": 25,
  "maximum_reviews_per_day": 9999,
  "optional_cards_separate": true,
  "user_delivery": {
    "finalizer": "flashcards/scripts/finalizar_entrega_canonica.py",
    "visible_files": ["e1_pdf", "apkg"],
    "hide_internal_work_artifacts": true,
    "manual_card_selection": false
  },
  "feedback": {
    "note_fields": ["NEBLI_Comentario", "NEBLI_Resposta", "NEBLI_Historico"],
    "regression_registry": "flashcards/tests/feedback_regressions.json",
    "regressions_required_in_ci": true
  },
  "apkg": {
    "writer": "flashcards/scripts/exportar_apkg_canonico.py",
    "stable_identity_field": "card_key",
    "audit": "flashcards/scripts/audit_apkg.py",
    "require_roundtrip_audit": true
  }
}
