#import "../typst-template/nebli_v2_apostila.typ": *

// etapa2.typ — Patologia do ovário e da tuba (pato-ovario-tuba), 30 objetivas
// Formato NEBLI clássico: questões sem gabarito inline; respostas só no
// gabarito consolidado (letras) ao fim do PDF.

// ===================== CONSOLIDAÇÃO (Q01–Q10) =====================

#questao-mc("01", badge-consolidacao,
  [A maioria absoluta dos cânceres de ovário origina-se de qual compartimento?],
  (("A", [Das células germinativas, sobretudo em crianças e adolescentes.]),
   ("B", [Das metástases de tumores gástricos e colorretais primários.]),
   ("C", [Do epitélio de superfície, responsável por cerca de 90% deles.]),
   ("D", [Do cordão sexual e estroma, com tumores hormonais funcionantes.])))

#questao-mc("02", badge-consolidacao,
  [Sobre o cisto folicular do ovário, assinale a afirmação correta.],
  (("A", [É neoplasia benigna que sempre exige exérese cirúrgica imediata.]),
   ("B", [Resulta de folículo não roto e em geral regride espontaneamente.]),
   ("C", [Tem conteúdo achocolatado por hemorragias menstruais repetidas.]),
   ("D", [Surge na pós-menopausa por estímulo androgênico mantido e crônico.])))

#questao-mc("03", badge-consolidacao,
  [Qual a tríade microscópica que confirma o endometrioma (cisto achocolatado)?],
  (("A", [Epitélio transicional em ninhos com estroma fibroso denso ao redor.]),
   ("B", [Células da granulosa luteinizadas revestindo conteúdo hemorrágico.]),
   ("C", [Vilosidades coriônicas revestidas por trofoblasto, com hemorragia.]),
   ("D", [Glândula e estroma endometriais com hemossiderina e macrófagos.])))

#questao-mc("04", badge-consolidacao,
  [Peça cística que ao corte libera material pastoso amarelado, pelos e um
   dente corresponde a qual tumor?],
  (("A", [Teratoma cístico maduro, tumor germinativo benigno e comum na jovem.]),
   ("B", [Cistadenoma mucinoso multiloculado de conteúdo gelatinoso espesso.]),
   ("C", [Carcinoma seroso de alto grau com áreas de necrose e hemorragia.]),
   ("D", [Cisto de corpo lúteo hemorrágico de parede luteinizada e fina.])))

#questao-mc("05", badge-consolidacao,
  [O fibroma ovariano apresenta-se tipicamente como:],
  (("A", [Cisto unilocular de parede fina e conteúdo seroso claro homogêneo.]),
   ("B", [Tumor multiloculado gelatinoso com implantes peritoneais mucinosos.]),
   ("C", [Massa sólida branca fasciculada, geralmente benigna e não funcionante.]),
   ("D", [Massa heterogênea com fluxo abundante e septos fibrovasculares.])))

#questao-mc("06", badge-consolidacao,
  [Massa ovariana sólida em jovem de 22 anos com LDH sérico elevado sugere:],
  (("A", [Fibroma ovariano com eventual síndrome de Meigs associada.]),
   ("B", [Disgerminoma, tumor germinativo maligno da jovem, radio e quimiossensível.]),
   ("C", [Cistadenoma seroso benigno previamente roto e depois torcido.]),
   ("D", [Tumor de Brenner com ninhos de epitélio transicional benigno.])))

#questao-mc("07", badge-consolidacao,
  [Assinale a característica típica do carcinoma seroso de alto grau.],
  (("A", [Benigno, sólido e esbranquiçado, achado quase sempre incidental.]),
   ("B", [Unilateral, indolente, originado de um cistadenoma preexistente.]),
   ("C", [Funcionante feminilizante, causando hiperplasia do endométrio.]),
   ("D", [Bilateral frequente, com papilas, ascite e mutação de TP53.])))

#questao-mc("08", badge-consolidacao,
  [Massa ovariana sólida bilateral em paciente com câncer gástrico sugere:],
  (("A", [Tumor de células da granulosa produtor de estrogênio e inibina.]),
   ("B", [Teratoma maduro bilateral com tecidos das três camadas embrionárias.]),
   ("C", [Tumor de Krukenberg, metástase com células em anel de sinete.]),
   ("D", [Cistadenoma seroso bilateral de paredes lisas, finas e benignas.])))

#questao-mc("09", badge-consolidacao,
  [Diante de um tumor de células da granulosa, qual conduta se impõe?],
  (("A", [Investigar o endométrio pelo risco de hiperplasia e carcinoma.]),
   ("B", [Dosar alfafetoproteína por ser tumor germinativo produtor de AFP.]),
   ("C", [Pesquisar metástase gástrica por se tratar de tumor metastático.]),
   ("D", [Tratar como abscesso, dada a origem inflamatória ascendente.])))

#questao-mc("10", badge-consolidacao,
  [O achado microscópico que confirma uma gravidez tubária é:],
  (("A", [Células em anel de sinete infiltrando a parede muscular da tuba.]),
   ("B", [Vilosidades coriônicas na parede da tuba, em meio a hemorragia.]),
   ("C", [Ninhos de células germinativas grandes com septos de linfócitos.]),
   ("D", [Glândulas tubárias mergulhadas em parede muscular espessa e nodular.])))

// ===================== INTEGRAÇÃO (Q11–Q25) =====================

#questao-mc("11", badge-integracao,
  [A endometriose ovariana, além do cisto achocolatado, predispõe a quais
   cânceres do ovário?],
  (("A", [Carcinoma seroso de alto grau e disgerminoma da mulher jovem.]),
   ("B", [Tumor de Brenner e cistadenoma seroso bilateral benigno comum.]),
   ("C", [Tumor de Krukenberg e coriocarcinoma gestacional de origem tubária.]),
   ("D", [Carcinoma endometrioide e carcinoma de células claras do ovário.])))

#questao-mc("12", badge-integracao,
  [A descoberta do STIC na fímbria tubária fundamenta qual recomendação?],
  (("A", [Ooforectomia bilateral profilática em toda mulher jovem saudável.]),
   ("B", [Dosagem rotineira de LDH no rastreamento do câncer epitelial.]),
   ("C", [Salpingectomia oportunística como profilaxia de câncer de ovário.]),
   ("D", [Histerectomia precoce para prevenir o carcinoma do endométrio.])))

#questao-mc("13", badge-integracao,
  [Qual achado ultrassonográfico mais eleva a categoria O-RADS de uma massa?],
  (("A", [Parede fina e lisa com conteúdo anecoico totalmente homogêneo.]),
   ("B", [Componente sólido com projeções papilíferas maiores que 3 mm e fluxo abundante.]),
   ("C", [Tamanho menor que 10 cm em um cisto unilocular simples típico.]),
   ("D", [Sombra acústica posterior em lesão sólida homogênea e regular.])))

#questao-mc("14", badge-integracao,
  [Por que a doença inflamatória pélvica prévia predispõe à gravidez ectópica?],
  (("A", [Cicatriza e obstrui a tuba, prendendo o zigoto na parede tubária.]),
   ("B", [Eleva o beta-hCG e simula uma gestação tópica ao ultrassom.]),
   ("C", [Transforma o epitélio tubário em focos ativos de endometriose.]),
   ("D", [Induz metaplasia mucinosa que bloqueia a captação do oócito.])))

#questao-mc("15", badge-integracao,
  [AFP elevada em massa ovariana de uma jovem aponta para qual componente?],
  (("A", [Disgerminoma puro, que tipicamente eleva apenas a LDH sérica.]),
   ("B", [Tumor de células da granulosa produtor de inibina e estradiol.]),
   ("C", [Coriocarcinoma, que se manifesta por hCG marcadamente elevado.]),
   ("D", [Tumor do saco vitelínico (seio endodérmico) no tumor germinativo.])))

#questao-mc("16", badge-integracao,
  [Lesão sólida hipoecoica homogênea, com sombra acústica e pouco fluxo, em
   mulher de 50 anos, é mais compatível com:],
  (("A", [Disgerminoma, tipicamente heterogêneo e hipervascularizado.]),
   ("B", [Carcinoma seroso de alto grau com ascite e papilas externas.]),
   ("C", [Fibroma ovariano, sólido e pouco vascularizado, com sombra acústica, benigno.]),
   ("D", [Teratoma maduro com sebo, dente e calcificações internas.])))

#questao-mc("17", badge-integracao,
  [O que distingue o tumor seroso borderline do carcinoma seroso invasor?],
  (("A", [O borderline é bilateral e o carcinoma é sempre estritamente unilateral.]),
   ("B", [O borderline tem atipia sem invadir o estroma; o carcinoma invade.]),
   ("C", [O borderline produz hCG e o carcinoma produz alfafetoproteína.]),
   ("D", [O borderline surge na pós-menopausa e o carcinoma na adolescência.])))

#questao-mc("18", badge-integracao,
  [Cisto ovariano grande que evolui com dor aguda e abdome em defesa indica:],
  (("A", [Torção do pedículo, complicação mecânica da massa anexial.]),
   ("B", [Disseminação peritoneal de um carcinoma seroso já avançado.]),
   ("C", [Infecção ascendente com formação de abscesso tubo-ovariano agudo.]),
   ("D", [Ruptura de cisto folicular com regressão espontânea esperada.])))

#questao-mc("19", badge-integracao,
  [Células em anel de sinete numa massa ovariana bilateral apontam para:],
  (("A", [Tumor germinativo primário com diferenciação trofoblástica focal.]),
   ("B", [Cistadenoma mucinoso primário do ovário, de bom prognóstico geral.]),
   ("C", [Tumor de Sertoli-Leydig androgênico, com virilização clínica.]),
   ("D", [Metástase de adenocarcinoma mucossecretor, em geral de origem gástrica.])))

#questao-mc("20", badge-integracao,
  [Sangramento na pós-menopausa em paciente com tumor sólido amarelado do
   ovário sugere:],
  (("A", [Disgerminoma produtor de LDH, com massa sólida grande na jovem.]),
   ("B", [Tumor de células da granulosa, feminilizante, com efeito endometrial.]),
   ("C", [Fibroma não funcionante associado à síndrome de Meigs e ascite.]),
   ("D", [Krukenberg metastático de adenocarcinoma gástrico mucossecretor.])))

#questao-mc("21", badge-integracao,
  [Carcinoma de ovário com implantes peritoneais fora da pelve corresponde a:],
  (("A", [T1a, tumor limitado a um ovário com a cápsula intacta e íntegra.]),
   ("B", [T3, por metástase peritoneal extrapélvica e/ou comprometimento de linfonodos retroperitoneais.]),
   ("C", [T1c, por ruptura da cápsula ocorrida durante o ato cirúrgico.]),
   ("D", [T2, por extensão pélvica abaixo do estreito superior da pelve.])))

#questao-mc("22", badge-integracao,
  [Lavado peritoneal "insuficiente" (acelular) num câncer com carcinomatose
   visível significa que:],
  (("A", [Não exclui a doença peritoneal já evidente a olho nu na cavidade.]),
   ("B", [Confirma a ausência de doença peritoneal, indicando estádio precoce.]),
   ("C", [Há obrigatoriamente células malignas livres flutuando na cavidade.]),
   ("D", [O tumor é benigno e de origem funcional, sem potencial de invasão.])))

#questao-mc("23", badge-integracao,
  [Sobre o teratoma cístico maduro, assinale a afirmação correta.],
  (("A", [É maligno na maioria dos casos e costuma metastatizar precocemente.]),
   ("B", [Ocorre tipicamente na pós-menopausa por estímulo hormonal mantido.]),
   ("C", [Sua transformação maligna mais comum é o coriocarcinoma trofoblástico.]),
   ("D", [O struma ovarii é variante com tecido tireoidiano funcionante.])))

#questao-mc("24", badge-integracao,
  [Gravidez ectópica íntegra, estável, com beta-hCG baixo e massa pequena pode
   ser tratada com:],
  (("A", [Cirurgia de urgência imediata, pelo risco iminente de choque.]),
   ("B", [Observação isolada, sem qualquer intervenção ou seguimento clínico.]),
   ("C", [Metotrexato, se preenchidos todos os critérios de elegibilidade.]),
   ("D", [Histerectomia total para controle definitivo do sangramento uterino.])))

#questao-mc("25", badge-integracao,
  [Ascite gelatinosa com implantes peritoneais mucinosos caracteriza:],
  (("A", [Carcinomatose do carcinoma seroso de alto grau, frequentemente bilateral.]),
   ("B", [Pseudomixoma peritonei, ligado a tumor mucinoso (muitas vezes apendicular).]),
   ("C", [Disseminação típica e precoce do disgerminoma da mulher jovem.]),
   ("D", [Síndrome de Meigs associada ao fibroma com derrame pleural reativo.])))

// ===================== APLICAÇÃO (Q26–Q30) =====================

#questao-mc("26", badge-aplicacao,
  [Mulher de 31 anos, dor aguda, US com cisto ovariano; na cirurgia há líquido
   achocolatado e aderências às alças. Diagnóstico mais provável:],
  (("A", [Endometrioma de ovário, com aderências e hidrossalpinge associadas.]),
   ("B", [Cistadenoma seroso torcido, de paredes finas, lisas e regulares.]),
   ("C", [Abscesso tubo-ovariano por doença inflamatória pélvica aguda.]),
   ("D", [Carcinoma seroso de alto grau com carcinomatose peritoneal difusa.])))

#questao-mc("27", badge-aplicacao,
  [Mulher de 76 anos com massa sólida, ascite e implantes em omento e alças.
   Hipótese principal:],
  (("A", [Cisto funcional fisiológico, de regressão espontânea esperada.]),
   ("B", [Teratoma maduro com sebo, pelos e nódulo de Rokitansky na parede.]),
   ("C", [Gravidez ectópica rota com hemoperitônio e instabilidade súbita.]),
   ("D", [Carcinoma seroso de alto grau em estádio avançado (pelo menos T3).])))

#questao-mc("28", badge-aplicacao,
  [Adolescente de 17 anos, massa sólida de 14 cm, seguida com beta-hCG e
   alfafetoproteína. O tumor é:],
  (("A", [Carcinoma endometrioide ligado a endometriose ovariana prévia.]),
   ("B", [Cistadenoma mucinoso multiloculado de grande volume e benigno.]),
   ("C", [Disgerminoma, tumor germinativo maligno acompanhado por marcadores séricos.]),
   ("D", [Tumor de células da granulosa feminilizante da mulher adulta.])))

#questao-mc("29", badge-aplicacao,
  [Mulher de 35 anos, "cisto complexo"; na cirurgia há saída de secreção
   amarelada e a microscopia mostra processo supurativo. Diagnóstico:],
  (("A", [Cistadenocarcinoma seroso com extensa necrose central tumoral.]),
   ("B", [Abscesso de ovário, complicação de doença inflamatória pélvica.]),
   ("C", [Endometrioma roto com reação inflamatória crônica do estroma.]),
   ("D", [Teratoma maduro infectado, com conteúdo sebáceo agora purulento.])))

#questao-mc("30", badge-aplicacao,
  [Mulher de 30 anos, cisto unilocular simples de 14 cm, paredes lisas, sem
   componente sólido. Classificação e laudo esperados:],
  (("A", [O-RADS 3 e cistadenoma seroso benigno, possivelmente torcido.]),
   ("B", [O-RADS 5 e carcinoma seroso de alto grau francamente infiltrativo.]),
   ("C", [O-RADS 1 e ovário normal com folículos puramente fisiológicos.]),
   ("D", [O-RADS 4 e tumor borderline com projeções papilíferas internas.])))
