#import "../typst-template/nebli_v2_apostila.typ": *

#resumindo-page((
  ([Algoritmo para nomear epitélio em lâmina],
   [Comece achando a lâmina basal. Conte camadas acima dela: 1 = simples; várias com todas tocando a basal = pseudoestratificado; várias com só a basal tocando = estratificado. Depois olhe a forma da camada superficial: achatada = pavimentoso, redonda = cúbico, alta = cilíndrico. Por fim, especialização apical (cílios, queratina).]),

  ([Pistas rápidas por subtipo simples],
   [Simples pavimentoso: linha fina com núcleos achatados (endotélio, mesotélio, alvéolos). Simples cúbico: quadradinhos com núcleo redondo central (túbulo renal, tireoide). Simples cilíndrico: tijolos verticais com núcleo oval na base (intestino, vesícula biliar).]),

  ([Pseudoestratificado × estratificado verdadeiro],
   [Pseudoestratificado parece estratificado mas TODA célula encosta na lâmina basal — só os núcleos estão em alturas diferentes. Aparece em traqueia, brônquios grandes e canal deferente. Esôfago NÃO é pseudoestratificado: é estratificado pavimentoso não queratinizado.]),

  ([Estratificado pavimentoso: queratinizado × não queratinizado],
   [Queratinizado tem estrato córneo morto anucleado por cima (epiderme da pele). Não queratinizado mantém núcleos até a superfície (esôfago, vagina, mucosa oral exceto gengiva). Ambos têm várias camadas com só a basal tocando a lâmina basal.]),

  ([Urotélio: o que muda quando a bexiga enche],
   [Urotélio (transição) tem células guarda-chuva em cúpula na superfície apical com placas de uroplaquina impermeáveis. Quando a bexiga enche, achata e o epitélio fica fino; vazia, fica espesso. Reveste todo o trato urinário superior — cálices, ureter, bexiga, uretra proximal.]),

  ([Especializações apicais — qual é qual],
   [Microvilos: curtos, actina, imóveis, absortivos (borda em escova). Estereocílios: microvilos longos (epidídimo, cóclea) — apesar do nome são microvilos. Cílios móveis: longos, microtúbulos 9+2 com dineína, batem (traqueia, tuba uterina). Cílio primário: único, 9+0, sensorial.]),

  ([Junções da região apical lateral],
   [De cima para baixo: zônula de oclusão (claudinas, veda paracelular e mantém polaridade); zônula de adesão (caderinas + actina, cinto mecânico Ca²⁺-dependente); desmossomos (caderinas + filamentos intermediários, rebites pontuais). Hemidesmossomos ancoram à lâmina basal por integrinas.]),

  ([Lâmina basal × membrana basal × PAS],
   [Lâmina basal = colágeno IV + lamininas + entactina + proteoglicanos; só visível ao microscópio eletrônico. Membrana basal = lâmina basal + fibras reticulares (colágeno III) do conjuntivo; visível ao microscópio óptico em PAS como linha rosa-magenta.]),

  ([Glândula exócrina: três eixos cruzados de classificação],
   [Eixo 1 — ducto: simples (sem ramos) × composto (ramificado). Eixo 2 — porção secretora: ramificada × não ramificada. Eixo 3 — forma da porção: tubular × acinar × tubuloacinar. Pâncreas exócrino: composto, ramificada, acinar. Sudorípara: simples, não ramificada, tubular.]),

  ([Mucoso × seroso × misto em HE],
   [Ácino mucoso: citoplasma pálido (muco não cora em HE), núcleo achatado basal, lúmen amplo. Ácino seroso: citoplasma eosinofílico, núcleo arredondado central, lúmen reduzido. Ácino misto: corpo mucoso com meia-lua serosa. Parótida=seroso, sublingual=mucoso, submandibular=misto.]),

  ([Endócrina: cordonal × folicular],
   [Cordonal: cordões de células entre capilares densos, sem armazenamento extracelular do produto. Exemplos: adrenal, paratireoide, hipófise, ilhotas pancreáticas. Folicular (tireoide): esferas de células cúbicas envolvendo coloide com tireoglobulina armazenada extracelularmente.]),

  ([Princípios universais do epitélio],
   [Justaposição com pouca matriz, polaridade apico-basal, ancoragem em lâmina basal, avascularidade (nutriente difunde do capilar do conjuntivo). Funções: revestir, proteger, absorver, secretar, perceber estímulos. Endotélio e mesotélio também são epitélio simples pavimentoso especializado.]),
))
