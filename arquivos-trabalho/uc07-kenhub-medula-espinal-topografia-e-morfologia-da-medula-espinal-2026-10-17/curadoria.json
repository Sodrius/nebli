 "anking": [
  {
   "nid": 1479515649019,
   "text_pt": "Os nervos C1 a C7 saem {{c1::acima::acima ou abaixo}} da vértebra correspondente",
   "extra_pt": "Ex.: C2 sai acima da vértebra C2. C8 sai abaixo de C7 e acima de T1, pois não há vértebra C8."
  },
  {
   "nid": 1479515759290,
   "text_pt": "A {{c1::cauda equina}} é formada pelas raízes dos nervos espinais lombares, sacrais e coccígeo abaixo do cone medular"
  },
  {
   "nid": 1479515737415,
   "text_pt": "Os corpos celulares dos neurônios das raízes anteriores dos nervos espinais ficam no {{c1::corno anterior}} da medula espinal"
  },
  {
   "nid": 1554475805095,
   "text_pt": "A lesão de uma artéria espinal posterior compromete as colunas dorsais {{c1::ipsilaterais::ipsilaterais, contralaterais ou ambas}}"
  },
  {
   "nid": 1480516743594,
   "text_pt": "Se há corno lateral, a medula espinal está entre {{c2::T1}} e {{c2::L2}}"
  },
  {
   "nid": 1480516748970,
   "text_pt": "Se não há corno lateral, a medula espinal está entre {{c1::C1}} e {{c1::C8}} ou {{c1::L3}} e {{c1::S5}}"
  },
  {
   "nid": 1480516724772,
   "text_pt": "Se o corno anterior é pequeno, o nível da medula espinal está entre {{c1::C1}} e {{c1::C4}} ou {{c1::T2}} e {{c1::L1}}"
  },
  {
   "nid": 1480514822870,
   "text_pt": "Se o corno anterior é grande, o nível da medula espinal está entre {{c1::C5}} e {{c1::T1}} ou {{c1::L2}} e {{c1::S2}}",
   "extra_pt": "Intumescências cervical (C5–T1) e lombossacral (L2–S2)."
  }
 ]
}