#let secoes-resumindo = (
  ([Matriz mineralizada define o tecido],
   [Osso é conjuntivo com matriz endurecida por hidroxiapatita. A dureza vem do mineral; a flexibilidade vem do colágeno tipo I. Sem mineral, dobra como tendão; sem colágeno, racha como giz.]),

  ([Três células, duas origens distintas],
   [Osteoblasto (mesênquima) fabrica matriz. Osteócito é osteoblasto aprisionado em lacuna, faz mecanotransdução. Osteoclasto vem da linhagem monócito-macrófago e reabsorve matriz mineralizada.]),

  ([RANK/RANKL/OPG decidem o saldo],
   [Osteoblasto expressa RANKL (gatilho da reabsorção) e OPG (freio). Osteoclasto expressa RANK. Estrogênio aumenta OPG; menopausa derruba estrogênio, derruba OPG, libera RANKL — osteoporose.]),

  ([Osteoclasto trabalha polarizado],
   [Zona de vedação por anel de actina isola a lacuna de Howship. Borda franzida bombeia H⁺ via V-ATPase, ácido dissolve hidroxiapatita, catepsina K digere colágeno I exposto. Material sai por transcitose.]),

  ([Hidroxiapatita = Ca₁₀(PO₄)₆(OH)₂],
   [Cristal depositado sobre colágeno I. Capa de hidratação ao redor permite troca iônica com líquido intersticial — o esqueleto vira reservatório regulado de cálcio e fosfato sanguíneos.]),

  ([Periósteo e endósteo nutrem e cicatrizam],
   [Bainhas externa e interna do osso. Camada osteogênica de ambas tem células-tronco que viram osteoblasto. Fonte permanente de células para crescimento em espessura e reparo de fratura.]),

  ([Ósteon = unidade do compacto lamelar],
   [Canal de Havers central com vaso, lamelas concêntricas, lacunas e canalículos. Cada osteócito fica a menos de 100 µm do vaso — limite imposto pela difusão. Canais de Volkmann atravessam transversalmente.]),

  ([Duas histogêneses paralelas],
   [Intramembranosa: mesênquima vira osso direto — ossos chatos do crânio, clavícula. Endocondral: mesênquima vira cartilagem hialina (molde), depois é substituída — ossos longos e curtos, placas epifisárias.]),

  ([Crescimento longitudinal pela placa epifisária],
   [Ossificação endocondral ativa até ~20 anos. Condrócitos proliferam na epífise, hipertrofiam e morrem na metáfise, osteoblastos substituem por matriz óssea. Hormônios sexuais fecham a placa.]),

  ([Reparo de fratura recapitula histogênese],
   [Hematoma → calo fibroso → calo cartilaginoso → calo ósseo primário não-lamelar → remodelação para lamelar. Os osteoblastos do calo vêm do periósteo e do endósteo locais.]),

  ([Compacto/esponjoso vs lamelar/não-lamelar],
   [Classificações ortogonais. Compacto/esponjoso é macro (densidade). Lamelar/não-lamelar é micro (organização do colágeno). No adulto, compacto e esponjoso são lamelares; não-lamelar é embrionário ou de reparo.]),

  ([Vitamina D, PTH e calcitonina ajustam calcemia],
   [Vitamina D aumenta absorção intestinal de cálcio e fosfato — sem ela, falta substrato e o osteóide não mineraliza (raquitismo, osteomalácia). PTH ativa reabsorção (sobe calcemia); calcitonina freia osteoclasto.]),
)

