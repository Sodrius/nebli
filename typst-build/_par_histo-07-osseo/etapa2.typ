  (
    ("A", [a fração inorgânica é responsável por toda a flexibilidade e resistência à tração da matriz mineralizada]),
    ("B", [a hidroxiapatita responde por 50-60% do peso seco e fornece resistência à compressão à matriz óssea]),
    ("C", [o colágeno tipo II domina a fração orgânica e organiza as lamelas concêntricas do ósteon adulto]),
    ("D", [os proteoglicanos sulfatados retêm água por osmose e sustentam a carga compressiva da matriz óssea]),
    ("E", [a fração orgânica supera 80% do peso seco e contém colágeno tipo III em feixes paralelos largos]),
