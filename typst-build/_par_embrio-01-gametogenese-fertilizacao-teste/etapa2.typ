// CONSOLIDAÇÃO
#questao-mc("01", badge-consolidacao, [Qual evento caracteriza a origem dos gametas antes da diferenciação sexual da gônada?],
  (("A", [Células germinativas primordiais migram para a crista genital e ali entram no programa gonadal apropriado.]), ("B", [Células somáticas da crista genital sofrem meiose e passam a constituir todas as linhagens germinativas.]), ("C", [Blastômeros periféricos do blastocisto migram diretamente para a gônada já diferenciada.]), ("D", [Células da massa celular interna permanecem no ovário e só depois se transformam em gametas.]), ("E", [Células foliculares migram do útero para a crista genital e originam os ovócitos primários.])))

#questao-mc("02", badge-consolidacao, [Em qual estado meiótico o ovócito liberado na ovulação normalmente se encontra?],
  (("A", [Prófase I, antes de completar a primeira divisão meiótica.]), ("B", [Metáfase I, antes de separar cromossomos homólogos.]), ("C", [Metáfase II, após completar a meiose I materna.]), ("D", [Anáfase II, separando cromátides-irmãs no ovócito.]), ("E", [Telófase II, já com segundo corpúsculo polar eliminado.])))

#questao-ce("03", badge-consolidacao, [Julgue os itens sobre os bloqueios e as divisões da meiose feminina.],
  (("I", [Ovócitos primários iniciam meiose I na vida fetal e permanecem bloqueados em prófase I por longo período.]), ("II", [Células de Sertoli secretam inibina B, que reduz a secreção de FSH.]), ("III", [A meiose I feminina reparte o citoplasma igualmente entre duas células funcionais.]), ("IV", [A fecundação permite que o ovócito secundário complete a meiose II.])))

#questao-mc("04", badge-consolidacao, [Qual mudança define capacitação, sem ainda constituir reação acrossômica?],
  (("A", [Modificações de membrana, iônicas e metabólicas que tornam o espermatozoide responsivo à zona pelúcida.]), ("B", [Exocitose do acrossomo com liberação enzimática para atravessar a zona pelúcida externa.]), ("C", [Fusão efetiva da membrana espermática com a membrana plasmática do ovócito maduro.]), ("D", [Conclusão efetiva da meiose II e eliminação do segundo corpúsculo polar feminino.]), ("E", [Descondensação progressiva do núcleo espermático para formar o pró-núcleo masculino paterno.])))

#questao-mc("05", badge-consolidacao, [Qual estrutura corresponde a uma matriz extracelular glicoproteica ao redor do ovócito?],
  (("A", [Corona radiata.]), ("B", [Blastocele.]), ("C", [Trofoectoderma.]), ("D", [Zona pelúcida.]), ("E", [Peça intermediária.])))

#questao-ce("06", badge-consolidacao, [Julgue os itens sobre capacitação e reação acrossômica.],
  (("I", [Células de Leydig respondem principalmente a FSH para sintetizar testosterona.]), ("II", [A reação acrossômica reorganiza membranas e libera conteúdo do acrossomo.]), ("III", [A reação expõe a membrana acrossômica interna.]), ("IV", [A reação acrossômica ajuda o espermatozoide a atravessar localmente a zona pelúcida.])))

#questao-mc("07", badge-consolidacao, [O aumento de Ca²⁺ no ovócito após fusão gamética desencadeia diretamente qual combinação?],
  (("A", [Capacitação espermática e reação acrossômica local.]), ("B", [Compactação mórula e formação da blastocele.]), ("C", [Migração germinativa inicial e espermiogênese tardia.]), ("D", [Meiose II e exocitose de grânulos corticais.]), ("E", [Eclosão completa do blastocisto e implantação.])) )

#questao-mc("08", badge-consolidacao, [Por que polispermia prejudica o desenvolvimento?],
  (("A", [Remove precocemente a zona pelúcida antes da clivagem inicial.]), ("B", [Impede diretamente a formação normal do pró-núcleo feminino.]), ("C", [Acrescenta genomas e centros organizadores, desorganizando fusos e segregação cromossômica.]), ("D", [Mantém indevidamente o ovócito bloqueado em prófase I prolongada.]), ("E", [Impede seletivamente a formação de células externas na mórula.])) )

#questao-ce("09", badge-consolidacao, [Julgue os itens sobre clivagem inicial.],
  (("I", [Junções firmes entre células de Sertoli formam a barreira hematotesticular.]), ("II", [Clivagem produz blastômeros progressivamente menores.]), ("III", [A zona pelúcida pode conter várias células derivadas do zigoto sem grande aumento de diâmetro.]), ("IV", [Clivagem começa apenas depois da eclosão do blastocisto.])))

#questao-mc("10", badge-consolidacao, [Qual transformação é produzida pela compactação da mórula?],
  (("A", [Produz dois pró-núcleos haploides no interior do ovócito.]), ("B", [Separa células internas de células externas polarizadas por aumento de adesão.]), ("C", [Libera enzimas acrossômicas para digerir a zona.]), ("D", [Completa a meiose II do ovócito antes da fertilização.]), ("E", [Transforma o trofoectoderma em massa celular interna.])))

// INTEGRAÇÃO
#questao-mc("11", badge-integracao, [Uma alteração impede que o ovócito libere grânulos corticais após a entrada do primeiro espermatozoide. Qual consequência é mais direta?],
  (("A", [Falha em capacitar espermatozoides no trato reprodutor feminino.]), ("B", [Maior risco de entrada de espermatozoides adicionais pela zona pelúcida.]), ("C", [Falha em formar o acrossomo funcional durante espermiogênese tardia.]), ("D", [Ausência precoce de células internas organizadas na mórula.]), ("E", [Interrupção precoce da migração das células germinativas primordiais.])) )

#questao-ce("12", badge-integracao, [Julgue os itens sobre o tempo da reação acrossômica.],
  (("I", [Reação acrossômica precoce demais pode comprometer a travessia funcional da zona.]), ("II", [Capacitação e reação acrossômica são o mesmo evento e ocorrem simultaneamente.]), ("III", [A competência para reagir precisa ser preservada até o contato adequado com a zona.]), ("IV", [A reação acrossômica transforma a corona radiata em trofoectoderma.])))

#questao-mc("13", badge-integracao, [Uma paciente ovula normalmente, mas a elevação de Ca²⁺ no ovócito não pode ocorrer após a fusão. Qual sequência ficará prejudicada?],
  (("A", [Retomada da meiose II e bloqueio cortical à polispermia.]), ("B", [Migração para crista genital e início da meiose I fetal.]), ("C", [Formação de flagelo e concentração de mitocôndrias.]), ("D", [Compactação e diferenciação do trofoectoderma.]), ("E", [Eclosão e adesão do blastocisto ao endométrio.])))

#questao-mc("14", badge-integracao, [Por que o embrião pode passar de zigoto a mórula sem aumentar muito de diâmetro?],
  (("A", [Porque perde metade do genoma em cada divisão inicial embrionária.]), ("B", [Porque cada clivagem reparte o citoplasma em blastômeros menores dentro da zona pelúcida.]), ("C", [Porque a zona pelúcida se converte gradualmente em citoplasma embrionário adicional.]), ("D", [Porque a blastocele comprime a mórula sólida desde a primeira divisão embrionária.]), ("E", [Porque o trofoectoderma impede toda síntese de membrana celular inicial.])) )

#questao-ce("15", badge-integracao, [Julgue os itens sobre células externas da mórula e cavitação.],
  (("I", [Células externas tornam-se polarizadas durante a compactação.]), ("II", [A função epitelial das células externas permite formar cavidade cheia de fluido.]), ("III", [A população interna da mórula origina diretamente a porção fetal da placenta.]), ("IV", [Transporte de íons e água pelas células externas contribui para formar a blastocele.])))

#questao-mc("16", badge-integracao, [Uma mutação reduz fortemente a adesão entre blastômeros no estágio de 8–16 células. Qual organização tende a falhar primeiro?],
  (("A", [A polarização entre população interna e externa que acompanha compactação.]), ("B", [A condensação do núcleo espermático durante espermiogênese.]), ("C", [A liberação do segundo corpúsculo polar durante fecundação.]), ("D", [A capacitação no trato reprodutor feminino.]), ("E", [A exocitose dos grânulos corticais após a fusão.])))

#questao-mc("17", badge-integracao, [Em um blastocisto, qual relação correta liga localização celular e destino?],
  (("A", [Massa celular interna forma principalmente a placenta fetal; trofoectoderma forma o embrião.]), ("B", [Blastocele forma diretamente os folhetos germinativos iniciais; zona pelúcida forma o embrião.]), ("C", [Massa celular interna origina embrião propriamente dito; trofoectoderma contribui para porção fetal da placenta.]), ("D", [Corona radiata origina trofoectoderma embrionário; zona pelúcida origina massa celular interna.]), ("E", [Grânulos corticais originam blastômeros externos iniciais; pró-núcleos originam blastocele.])) )

#questao-ce("18", badge-integracao, [Julgue os itens sobre zona pelúcida e eclosão.],
  (("I", [Eclosão corresponde à saída do blastocisto da zona pelúcida.]), ("II", [A eclosão permite contato direto do trofoectoderma com o endométrio.]), ("III", [A eclosão antecede a primeira clivagem do zigoto.]), ("IV", [Enquanto persiste, a zona ajuda a evitar implantação prematura.])))

#questao-mc("19", badge-integracao, [A mesma mulher tem ovócitos que permanecem anos em diplóteno, mas um ovócito ovulado está em metáfase II. Qual transição ocorreu entre esses estados?],
