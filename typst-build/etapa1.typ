  columns: 3,
  fill: (col, row) => if row == 0 { rgb("#1f3551") } else { none },
  stroke: 0.5pt + rgb("#5a6c84"),
  inset: 7pt,
  [#text(white, weight: "bold")[Posição da ponta]],
  [#text(white, weight: "bold")[Frequência]],
