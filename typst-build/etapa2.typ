#questao-ce("21", badge-integracao,
  [Julgue os itens sobre a fronteira entre adaptação e neoplasia:],
  (("I", [a hiperplasia patológica continua obedecendo ao sinal que a desencadeou e regride quando esse sinal é retirado]),
   ("II", [a metaplasia é reversível, e o epitélio original tende a se restabelecer quando o agressor é removido]),
