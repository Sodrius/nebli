#import "../typst-template/nebli_v2_apostila.typ": *

#questao-mc("01", badge-consolidacao,
  [A oscilação rítmica do potencial de repouso que define o ritmo básico da motilidade é gerada por qual estrutura?],
  (("A", [O miócito da camada circular, por despolarização espontânea da própria membrana.]),
   ("B", [A célula intersticial de Cajal, acoplada ao miócito por junções comunicantes.]),
   ("C", [O neurônio do plexo submucoso, por descarga rítmica de acetilcolina.]),
   ("D", [O terminal vagal pré-ganglionar, por liberação tônica de transmissor.]),
   ("E", [A célula enterocromafim da mucosa, por secreção pulsátil de serotonina.])))

#questao-ce("02", badge-consolidacao,
  [Julgue os itens sobre a onda lenta do trato gastrointestinal.],
  (("I",   [A onda lenta é uma oscilação do potencial de repouso e não produz contração nos ciclos em que o limiar não é atingido.]),
   ("II",  [A frequência da onda lenta é de cerca de 3 por minuto no corpo do estômago e de 12 por minuto no duodeno.]),
   ("III", [A frequência da onda lenta aumenta progressivamente no sentido oral-aboral ao longo de todo o tubo.]),
   ("IV",  [A onda lenta se propaga da célula marcapasso ao músculo pelas junções comunicantes.])))

#questao-mc("03", badge-consolidacao,
  [Qual plexo do sistema nervoso entérico governa a motilidade, e onde ele se situa?],
  (("A", [O plexo submucoso, situado entre a mucosa e a camada muscular circular.]),
   ("B", [O plexo mioentérico, situado entre as camadas circular e longitudinal.]),
   ("C", [O plexo submucoso, situado entre as camadas circular e longitudinal.]),
   ("D", [O plexo mioentérico, situado logo abaixo do epitélio de revestimento.]),
   ("E", [O plexo celíaco, situado na raiz do mesentério, junto à aorta abdominal.])))

#questao-mc("04", badge-consolidacao,
  [Quais transmissores são liberados pelos motoneurônios inibitórios do plexo mioentérico?],
  (("A", [Acetilcolina e substância P, liberadas por neurônios que contraem a camada circular.]),
   ("B", [Noradrenalina e neuropeptídeo Y, liberadas por fibras pós-ganglionares do gânglio celíaco.]),
   ("C", [Serotonina e histamina, liberadas pelas células enterocromafins da mucosa intestinal.]),
   ("D", [Peptídeo intestinal vasoativo e óxido nítrico, liberados por neurônios do plexo mioentérico.]),
   ("E", [Glutamato e glicina, liberados pelos interneurônios que distribuem o sinal no plexo.])))

#questao-mc("05", badge-consolidacao,
  [O que caracteriza a contração tônica do músculo liso digestório?],
  (("A", [Contração breve, de segundos, cuja força acompanha o transiente de cálcio.]),
   ("B", [Contração sustentada, de minutos a horas, cuja força permanece em platô.]),
   ("C", [Contração de amplitude máxima, obtida quando todos os canais tipo L se abrem.]),
   ("D", [Contração involuntária desencadeada exclusivamente por estímulo vagal mantido.]),
   ("E", [Contração rítmica cuja frequência acompanha a onda lenta daquele segmento.])))

#questao-ce("06", badge-consolidacao,
  [Julgue os itens sobre os esfíncteres do tubo digestório.],
  (("I",   [O esfíncter esofágico superior é composto por músculo esquelético.]),
   ("II",  [O esfíncter anal externo é músculo liso involuntário, inervado pelo plexo mioentérico.]),
   ("III", [Em repouso o esfíncter encontra-se relaxado, e contrai-se quando o conteúdo se aproxima.]),
   ("IV",  [O esfíncter esofágico inferior é uma zona de alta pressão sem espessamento muscular macroscópico distinto.])))

#questao-mc("07", badge-consolidacao,
  [No músculo liso, qual proteína liga o cálcio citosólico e transmite o sinal à maquinaria contrátil?],
  (("A", [A troponina C, que desloca a tropomiosina e libera os sítios da actina.]),
   ("B", [A titina, que ancora o filamento grosso e ajusta a tensão passiva.]),
   ("C", [A tropomiosina, que ocupa o sulco da actina e bloqueia a cabeça de miosina.]),
   ("D", [A caldesmona, que fosforila diretamente a cadeia leve reguladora da miosina.]),
   ("E", [A calmodulina, que liga quatro íons e ativa a quinase da cadeia leve.])))

#questao-mc("08", badge-consolidacao,
  [Qual é o substrato fosforilado pela quinase da cadeia leve da miosina?],
  (("A", [A actina G, no sítio de ligação à cabeça de miosina.]),
   ("B", [A cadeia leve reguladora da própria miosina, no resíduo serina 19.]),
   ("C", [A subunidade reguladora da miosina fosfatase, inibindo a enzima.]),
   ("D", [A calmodulina, aumentando sua afinidade pelo cálcio citosólico.]),
   ("E", [O canal de cálcio tipo L, prolongando o tempo de abertura.])))

#questao-ce("09", badge-consolidacao,
  [Julgue os itens sobre a junção neuroefetora do músculo liso visceral.],
  (("I",   [A liberação de transmissor ocorre em varicosidades ao longo do axônio, sem botão terminal único.]),
   ("II",  [A distância entre a varicosidade e o miócito é fixa, em torno de 50 nm.]),
   ("III", [A ausência de receptores concentrados torna a resposta lenta e graduada.]),
   ("IV",  [Uma única varicosidade influencia várias células, e o sincício amplia o alcance da resposta.])))

#questao-mc("10", badge-consolidacao,
  [Qual proteína G acopla o receptor muscarínico M3 à fosfolipase C beta no músculo liso?],
  (("A", [A proteína Gs, que ativa a adenilato-ciclase e eleva o AMP cíclico.]),
   ("B", [A proteína Gi, que inibe a adenilato-ciclase e reduz o AMP cíclico.]),
   ("C", [A proteína G12/13, que ativa a RhoA por meio de um fator de troca.]),
   ("D", [A proteína Gq, que ativa a fosfolipase C beta e gera IP₃ e DAG.]),
   ("E", [A proteína transducina, que ativa a fosfodiesterase de GMP cíclico.])))

#questao-mc("11", badge-integracao,
  [Em um segmento de duodeno isolado, registros simultâneos mostram ondas lentas de frequência constante, mas contrações apenas em alguns ciclos. A explicação mecanística para essa dissociação é:],
  (("A", [A onda lenta é conduzida pelas junções comunicantes apenas em parte dos ciclos; nos demais o sincício se desacopla e a despolarização não alcança a camada circular.]),
   ("B", [A frequência da onda lenta varia ciclo a ciclo conforme a atividade das células marcapasso, e apenas os ciclos de maior frequência conseguem atingir o limiar de contração.]),
   ("C", [A onda lenta apenas aproxima o potencial do limiar; a contração exige que estímulos excitatórios somem despolarização suficiente para abrir canais de cálcio tipo L naquele ciclo.]),
   ("D", [A onda lenta abre diretamente os canais de cálcio tipo L, mas o íon que entra só ativa a calmodulina quando o retículo sarcoplasmático já se encontra previamente saturado.]),
   ("E", [A contração ocorre nos ciclos em que a miosina fosfatase é transitoriamente inibida, independentemente de a onda lenta ter ou não alcançado o limiar de disparo naquele ciclo.])))

#questao-mc("12", badge-integracao,
  [Num registro de contração tônica, o transiente de cálcio retorna quase à linha de base em segundos, enquanto a força se mantém em platô por minutos. O mecanismo que sustenta esse platô é:],
  (("A", [A entrada contínua de cálcio pelos canais tipo L mantém a calmodulina saturada, e o registro citosólico global apenas não detecta o íon confinado ao espaço submembranar.]),
   ("B", [A miosina fosfatase é irreversivelmente inativada durante a contração tônica, de modo que a cadeia leve permanece fosforilada até que novas moléculas da enzima sejam sintetizadas.]),
   ("C", [A troponina C do músculo liso retém cálcio com afinidade muito alta e mantém a tropomiosina deslocada mesmo depois que o cálcio citosólico já retornou ao nível basal.]),
   ("D", [O retículo sarcoplasmático libera cálcio de forma pulsátil e sincronizada com a onda lenta, o que repõe o íon consumido e sustenta a taxa de fosforilação nova.]),
   ("E", [Pontes cruzadas já ligadas à actina permanecem unidas depois de desfosforiladas, com desprendimento muito lento — o estado latch, que sustenta força com pouco gasto de ATP.])))

#questao-ce("13", badge-integracao,
  [Julgue os itens sobre o reflexo peristáltico intramural.],
  (("I",   [A distensão da parede despolariza mecanorreceptores cujo neurônio sensitivo tem o corpo celular no próprio plexo mioentérico.]),
   ("II",  [No segmento oral ao bolo, interneurônios recrutam motoneurônios que liberam acetilcolina e substância P, contraindo a camada circular.]),
   ("III", [No segmento aboral, o relaxamento decorre apenas da retirada do estímulo excitatório, sem motoneurônio próprio envolvido.]),
   ("IV",  [Um segmento intestinal isolado e desnervado perde a capacidade de propagar conteúdo, o que demonstra a dependência do comando vagal.])))

#questao-mc("14", badge-integracao,
  [A fibra parassimpática pré-ganglionar do nervo vago que alcança a parede do estômago termina:],
  (("A", [em neurônio do plexo mioentérico, que é quem inerva o músculo liso — o comando extrínseco entra no circuito intrínseco e ajusta o ganho dele.]),
   ("B", [diretamente na membrana do miócito da camada circular, sobre receptores muscarínicos concentrados numa placa motora semelhante à do músculo esquelético.]),
   ("C", [em gânglio paravertebral da cadeia simpática, de onde parte a fibra pós-ganglionar longa que alcança a parede do tubo e libera noradrenalina.]),
   ("D", [na célula intersticial de Cajal, que passa então a impor ao músculo a frequência de disparo ditada pelo núcleo motor dorsal do vago.]),
   ("E", [no plexo submucoso, de onde o sinal é retransmitido à camada muscular circular por interneurônios que atravessam a lâmina própria da mucosa.])))

#questao-mc("15", badge-integracao,
  [Durante uma descarga simpática intensa, o efeito sobre a musculatura da parede e sobre os esfíncteres é:],
  (("A", [inibição da parede e inibição dos esfíncteres, pois a noradrenalina relaxa todo o músculo liso digestório por meio de receptores beta-adrenérgicos.]),
   ("B", [inibição da parede, sobretudo por receptores alfa-2 pré-sinápticos que cortam a liberação de acetilcolina, e contração dos esfíncteres — sinais opostos com a mesma finalidade.]),
   ("C", [excitação da parede e contração dos esfíncteres, porque a noradrenalina despolariza o miócito e eleva a frequência da onda lenta em todo o tubo.]),
   ("D", [inibição da parede e contração dos esfíncteres, ambas obtidas pela liberação de peptídeo intestinal vasoativo pelas fibras pós-ganglionares simpáticas.]),
   ("E", [ausência de efeito direto sobre a parede, já que o simpático inerva apenas os vasos da mucosa e a musculatura lisa vascular da submucosa.])))

#questao-ce("16", badge-integracao,
  [Julgue os itens sobre a regulação do piloro e do esvaziamento gástrico.],
  (("I",   [A distensão do antro gera regulação anterógrada, que relaxa o piloro e favorece o esvaziamento.]),
   ("II",  [A chegada de quimo ácido e hipertônico ao duodeno gera regulação retrógrada, que contrai o piloro.]),
   ("III", [O esvaziamento gástrico é ajustado à capacidade do duodeno de neutralizar e absorver o conteúdo recebido.]),
   ("IV",  [O sinal duodenal retrógrado relaxa o piloro e acelera a entrega de quimo quando a carga ácida aumenta.])))

#questao-mc("17", badge-integracao,
  [A resposta do músculo liso visceral à estimulação autonômica é lenta, graduada e difusa. A base estrutural dessa característica é:],
  (("A", [a presença de placa motora ampla, com receptores dispersos por toda a superfície do miócito, o que dilui o transmissor e retarda a resposta local.]),
   ("B", [a liberação por varicosidades a distâncias de 20 a mais de 100 nm, sem receptor concentrado, somada ao acoplamento elétrico que espalha a resposta pelo sincício.]),
   ("C", [a lentidão intrínseca da miosina visceral, cuja ATPase cicla devagar e impede resposta rápida mesmo quando o transmissor chega em concentração alta ao receptor.]),
   ("D", [a ausência de canais de cálcio voltagem-dependentes na membrana do miócito visceral, o que obriga o íon a entrar exclusivamente por difusão passiva lenta.]),
   ("E", [a degradação lenta da acetilcolina na fenda, já que o músculo liso não expressa acetilcolinesterase e o transmissor permanece ativo por vários segundos.])))

#questao-mc("18", badge-integracao,
  [Um esfíncter mantém pressão elevada por horas com cálcio citosólico próximo do valor basal. A via que explica essa dissociação entre cálcio e força é:],
  (("A", [a ativação sustentada da quinase da cadeia leve pela calmodulina, que permanece ocupada mesmo em concentrações basais de cálcio graças à sua altíssima afinidade.]),
   ("B", [o bloqueio da Ca²⁺-ATPase do retículo sarcoplasmático, que impede a recaptação e mantém um reservatório citosólico oculto de cálcio disponível para a quinase.]),
   ("C", [a ativação de RhoA e da Rho-quinase, que inibem a miosina fosfatase e fazem a mesma taxa de fosforilação acumular mais cadeias leves fosforiladas ao longo do tempo.]),
   ("D", [a fosforilação da troponina C pela proteína quinase C, que aumenta a sensibilidade do filamento fino ao cálcio ainda disponível no citosol do miócito.]),
   ("E", [o aumento da condutância ao potássio, que hiperpolariza a membrana e prolonga a abertura dos canais de cálcio tipo L durante todo o período de tônus.])))

#questao-ce("19", badge-integracao,
  [Julgue os itens sobre o óxido nítrico como mediador do relaxamento no tubo digestório.],
  (("I",   [O óxido nítrico é armazenado em vesículas sinápticas e liberado por exocitose no terminal inibitório.]),
   ("II",  [No miócito, ativa a guanilato-ciclase solúvel, e o GMPc formado ativa a proteína quinase G.]),
   ("III", [Por circular no plasma com meia-vida longa, relaxa segmentos distantes do terminal que o produziu.]),
   ("IV",  [A proteína quinase G promove contração ao inibir a miosina fosfatase, do mesmo modo que a Rho-quinase.])))

#questao-mc("20", badge-integracao,
  [Sobre a organização e a autonomia do sistema nervoso entérico, assinale a alternativa *incorreta*.],
  (("A", [O plexo mioentérico situa-se entre as camadas circular e longitudinal e governa contração e relaxamento, tanto fásicos quanto tônicos.]),
   ("B", [O plexo submucoso situa-se sob a mucosa e governa secreção e fluxo sanguíneo local, funções coerentes com a sua posição anatômica.]),
   ("C", [O arco reflexo intramural é completo dentro da parede, com neurônio sensitivo, interneurônio e motoneurônio, sem depender de estrutura externa.]),
   ("D", [O relaxamento do músculo liso digestório é evento ativo, produzido por motoneurônios próprios que liberam peptídeo intestinal vasoativo e óxido nítrico.]),
   ("E", [O sistema nervoso entérico é um ramo do parassimpático, e seus corpos neuronais localizam-se nos gânglios pré-vertebrais celíaco e mesentéricos.])))

#questao-mc("21", badge-integracao,
  [Em recém-nascido com aganglionose congênita do retossigmoide, a relação entre a topografia da lesão e a da dilatação é:],
  (("A", [o segmento aganglionar está dilatado por perda do tônus muscular, e o intestino proximal, inervado, mantém calibre normal e peristalse eficaz.]),
   ("B", [tanto o segmento aganglionar quanto o proximal estão dilatados, já que a perda dos plexos se propaga por continuidade ao longo da parede do tubo.]),
   ("C", [o segmento aganglionar permanece contraído por falta de motoneurônios inibitórios, e o intestino proximal, inervado, dilata ao empurrar contra obstrução funcional.]),
   ("D", [o segmento aganglionar contrai-se por hiperatividade colinérgica compensatória, e o intestino proximal reduz o calibre por desuso prolongado da sua musculatura.]),
   ("E", [a dilatação surge apenas após colonização bacteriana do segmento distal, sem relação com a distribuição dos neurônios derivados da crista neural.])))

#questao-mc("22", badge-integracao,
  [Num paciente com megaesôfago chagásico, o nitrato administrado antes das refeições reduz a disfagia. O mecanismo dessa resposta é:],
  (("A", [bloqueio dos canais de cálcio tipo L do esfíncter, o que reduz o substrato da calmodulina e a ativação da quinase da cadeia leve da miosina.]),
   ("B", [clivagem de proteínas SNARE nos terminais excitatórios remanescentes, o que impede a liberação de acetilcolina e remove o tônus colinérgico residual do esfíncter.]),
   ("C", [regeneração dos motoneurônios inibitórios destruídos, com restauração progressiva da liberação endógena de peptídeo intestinal vasoativo pelo plexo mioentérico esofágico.]),
   ("D", [aumento da amplitude das ondas peristálticas do corpo esofágico, o que gera pressão suficiente para vencer o esfíncter que permanece hipertônico.]),
   ("E", [doação de óxido nítrico, que repõe o mediador perdido e ativa a guanilato-ciclase solúvel e a proteína quinase G, favorecendo a miosina fosfatase.])))

#questao-ce("23", badge-integracao,
  [Julgue os itens sobre a retirada do cálcio citosólico e o fim da contração.],
  (("I",   [A Ca²⁺-ATPase do retículo sarcoplasmático expulsa o cálcio para o meio extracelular.]),
   ("II",  [O trocador sódio-cálcio aproveita o gradiente de sódio mantido pela Na⁺/K⁺-ATPase.]),
   ("III", [A Ca²⁺-ATPase da membrana plasmática bombeia cálcio para fora da célula consumindo ATP.]),
   ("IV",  [Retirado o cálcio do citosol, a contração cessa mesmo que a cadeia leve permaneça fosforilada.])))

#questao-mc("24", badge-integracao,
  [Comparando o músculo liso visceral com o músculo estriado, assinale a alternativa *incorreta*.],
  (("A", [O músculo liso visceral não possui troponina, e o cálcio citosólico é recebido pela calmodulina, que ativa a quinase da cadeia leve da miosina.]),
   ("B", [A regulação da contração no músculo liso ocorre sobre o filamento grosso, liberando a atividade ATPásica da própria cabeça de miosina.]),
   ("C", [As células do músculo liso visceral compartilham o citoplasma num sincício anatômico verdadeiro, o que torna dispensáveis as junções comunicantes entre elas.]),
   ("D", [O acoplamento elétrico por junções comunicantes permite que a despolarização de uma célula alcance as vizinhas sem sinapse interposta.]),
   ("E", [O relaxamento exige a miosina fosfatase, porque a queda do cálcio apenas cessa a fosforilação nova sem remover o fosfato já ligado.])))

#questao-ce("25", badge-integracao,
  [Julgue os itens sobre o comando simpático dirigido ao tubo digestório.],
  (("I",   [O comando simpático relaxa a musculatura da parede e relaxa igualmente os esfíncteres.]),
   ("II",  [A noradrenalina age em receptores alfa-2 pré-sinápticos do neurônio entérico e reduz a liberação de acetilcolina.]),
   ("III", [O simpático produz vasodilatação da mucosa, aumentando o fluxo esplâncnico durante o estresse.]),
   ("IV",  [O efeito inibitório simpático é exercido sobretudo sobre a fibra muscular, sem interferir na transmissão entérica.])))

#questao-mc("26", badge-aplicacao,
  [Lactente de seis semanas com distensão abdominal progressiva, vômitos biliosos e eliminação de mecônio apenas no terceiro dia de vida. O enema opaco mostra reto de calibre estreito com dilatação do sigmoide acima. O mecanismo do quadro é:],
  (("A", [ausência de neurônios dos plexos intramurais no segmento estreito, que não relaxa por falta de motoneurônios inibitórios, com dilatação do intestino inervado a montante.]),
   ("B", [hipertrofia da camada circular do segmento estreito por hiperestimulação vagal crônica, com dilatação passiva do sigmoide pelo acúmulo progressivo de conteúdo fecal.]),
   ("C", [depleção das células intersticiais de Cajal do sigmoide, que desorganiza a onda lenta e dilata o segmento marcapasso sem alterar o calibre do reto.]),
   ("D", [destruição inflamatória dos neurônios do plexo mioentérico por agente infeccioso, com o segmento estreito correspondendo à área de maior carga parasitária.]),
   ("E", [falha de fechamento da camada muscular durante o dobramento embrionário, com estenose fixa do reto e dilatação puramente mecânica do segmento proximal.])))

#questao-mc("27", badge-aplicacao,
  [Homem de 47 anos, de área endêmica de doença de Chagas, com disfagia progressiva para sólidos e líquidos há dois anos. A esofagografia mostra esôfago dilatado com afilamento distal, e a manometria registra ausência de relaxamento do esfíncter esofágico inferior à deglutição. O defeito é:],
  (("A", [fibrose da camada muscular circular do esôfago distal, que impede mecanicamente a abertura do esfíncter apesar de a inervação intramural estar preservada.]),
   ("B", [perda dos motoneurônios inibitórios do plexo mioentérico esofágico, com falta do peptídeo intestinal vasoativo e do óxido nítrico que relaxariam o esfíncter.]),
   ("C", [perda dos motoneurônios excitatórios do plexo mioentérico, com queda do tônus colinérgico e incapacidade de gerar peristalse no corpo do esôfago.]),
   ("D", [destruição das células intersticiais de Cajal esofágicas, que suprime a onda lenta e impede a propagação da contração até o esfíncter distal.]),
   ("E", [hiperatividade das fibras simpáticas pós-ganglionares que inervam o esfíncter, mantendo-o contraído por estímulo noradrenérgico contínuo e sustentado.])))

#questao-ce("28", badge-aplicacao,
  [Mulher de 54 anos, terceiro dia após laparotomia para colectomia. Abdome distendido e timpânico, ruídos hidroaéreos ausentes, sem sinais de irritação peritoneal; a tomografia não mostra ponto de transição. Julgue os itens.],
  (("I",   [O quadro é compatível com íleo paralítico, em que a motilidade cessa sem obstrução mecânica.]),
   ("II",  [A manipulação peritoneal dispara, por arco espinhal, descarga simpática prolongada sobre todo o tubo.]),
   ("III", [A recuperação esperada da motilidade é mais rápida no cólon do que no intestino delgado.]),
   ("IV",  [A ausência de ruídos hidroaéreos, neste contexto, indica necrose intestinal e impõe reabordagem imediata.])))

#questao-mc("29", badge-aplicacao,
  [Mulher de 58 anos, com diabetes de vinte anos de evolução e neuropatia periférica estabelecida, refere plenitude pós-prandial precoce e vômitos de alimento ingerido horas antes. A endoscopia digestiva alta é normal, sem lesão obstrutiva; a cintilografia de esvaziamento gástrico mostra retenção de 70% do radiotraçador em quatro horas. O mecanismo mais provável é:],
  (("A", [estenose funcional do piloro por hipertrofia da camada circular, que aumenta a resistência mecânica à saída do conteúdo gástrico para o duodeno.]),
   ("B", [perda dos motoneurônios excitatórios do plexo mioentérico gástrico, com incapacidade de liberar acetilcolina sobre a camada circular do antro.]),
   ("C", [depleção das células intersticiais de Cajal, que desorganiza a onda lenta gástrica e reduz a propulsão apesar de musculatura e inervação preservadas.]),
   ("D", [falha do relaxamento receptivo do fundo gástrico, que reduz a acomodação e desloca o conteúdo prematuramente para o duodeno após a refeição.]),
   ("E", [aumento do tônus simpático esplâncnico, que contrai os esfíncteres e relaxa a parede, produzindo retenção por obstrução funcional distal ao antro.])))

