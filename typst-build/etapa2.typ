#questao-ce("05", badge-consolidacao,
  [Julgue os itens sobre o mecanismo da atrofia:],
  (("I", [as células de um órgão atrófico estão vivas e funcionantes, com menos organelas e menor volume de citoplasma]),
   ("II", [a via ubiquitina-proteassoma degrada proteínas etiquetadas individualmente, enquanto a autofagia digere organelas e porções inteiras de citoplasma]),
   ("III", [corticoides e hormônio tireoidiano reduzem a degradação proteica, ao passo que a insulina a estimula]),
