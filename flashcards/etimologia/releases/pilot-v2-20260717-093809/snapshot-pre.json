[
  {
    "noteId": 1784291821324,
    "uid": "etim-v2-fnd-morfema",
    "Text": "Palavras como nefrite dividem-se em unidades significativas chamadas {{c1::morfemas}}.",
    "Extra": "Cada morfema contribui uma pista de sentido.",
    "tags": [
      "etim_uid::etim-v2-fnd-morfema",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821332,
    "uid": "etim-v2-fnd-prefixo",
    "Text": "Em subcutâneo, <b>sub-</b> ocupa o início e funciona como {{c1::prefixo}}.",
    "Extra": "Ele modifica o sentido da raiz cutane-.",
    "tags": [
      "etim_uid::etim-v2-fnd-prefixo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821337,
    "uid": "etim-v2-fnd-raiz",
    "Text": "Em hepatite, <b>hepat-</b> carrega o referente anatômico como {{c1::raiz}}.",
    "Extra": "A raiz concentra o núcleo semântico.",
    "tags": [
      "etim_uid::etim-v2-fnd-raiz",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821342,
    "uid": "etim-v2-fnd-sufixo",
    "Text": "Em gastrite, <b>-ite</b> encerra e classifica o termo como {{c1::sufixo}}.",
    "Extra": "O sufixo costuma indicar processo, condição ou procedimento.",
    "tags": [
      "etim_uid::etim-v2-fnd-sufixo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821348,
    "uid": "etim-v2-fnd-forma-combinatoria",
    "Text": "Em cardiologia, <b>cardi/o</b> é raiz mais vogal: uma {{c1::forma combinatória}}.",
    "Extra": "A barra separa raiz e vogal de ligação.",
    "tags": [
      "etim_uid::etim-v2-fnd-forma-combinatoria",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821353,
    "uid": "etim-v2-fnd-vogal-de-ligacao",
    "Text": "Em cardiologia, o <b>o</b> une cardi- a -logia como {{c1::vogal de ligação}}.",
    "Extra": "Ela facilita a pronúncia; não acrescenta sentido.",
    "tags": [
      "etim_uid::etim-v2-fnd-vogal-de-ligacao",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821359,
    "uid": "etim-v2-fnd-decomposicao",
    "Text": "Separar pancitopenia em pan- + cit/o + -penia é {{c1::decomposição}}.",
    "Extra": "A separação torna as pistas morfológicas visíveis.",
    "tags": [
      "etim_uid::etim-v2-fnd-decomposicao",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821365,
    "uid": "etim-v2-fnd-composicao",
    "Text": "Unir nefr/o a -logia para formar nefrologia é {{c1::composição}}.",
    "Extra": "A palavra resulta da união de elementos.",
    "tags": [
      "etim_uid::etim-v2-fnd-composicao",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821371,
    "uid": "etim-v2-fnd-derivacao",
    "Text": "Acrescentar hiper- a tensão forma hipertensão por {{c1::derivação}}.",
    "Extra": "Aqui, a derivação ocorre por prefixação.",
    "tags": [
      "etim_uid::etim-v2-fnd-derivacao",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821378,
    "uid": "etim-v2-fnd-cognato",
    "Text": "Renal e ren/o descendem da mesma forma latina; são {{c1::cognatos}}.",
    "Extra": "Cognatos compartilham origem, não necessariamente uso idêntico.",
    "tags": [
      "etim_uid::etim-v2-fnd-cognato",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821384,
    "uid": "etim-v2-fnd-transliteracao",
    "Text": "Escrever νεφρός como nephrós em alfabeto latino é {{c1::transliteração}}.",
    "Extra": "Transliteração troca escrita, não traduz o significado.",
    "tags": [
      "etim_uid::etim-v2-fnd-transliteracao",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821392,
    "uid": "etim-v2-fnd-eponimo",
    "Text": "Parkinson nomeia uma doença a partir de pessoa; é {{c1::epônimo}}.",
    "Extra": "Epônimos não se decompõem em morfemas médicos.",
    "tags": [
      "etim_uid::etim-v2-fnd-eponimo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821400,
    "uid": "etim-v2-fnd-acronimo",
    "Text": "A sigla pronunciável <b>laser</b> funciona como {{c1::acrônimo}}.",
    "Extra": "Acrônimos exigem conhecer a expansão histórica.",
    "tags": [
      "etim_uid::etim-v2-fnd-acronimo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821407,
    "uid": "etim-v2-fnd-polissemia",
    "Text": "<b>miel/o</b> pode indicar medula óssea ou espinal; isso é {{c1::polissemia}}.",
    "Extra": "O contexto decide qual sentido está ativo.",
    "tags": [
      "etim_uid::etim-v2-fnd-polissemia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821414,
    "uid": "etim-v2-fnd-glosa-literal",
    "Text": "Somar os sentidos de nefr/o e -patia produz a {{c1::glosa literal}}.",
    "Extra": "A glosa orienta; não determina o diagnóstico.",
    "tags": [
      "etim_uid::etim-v2-fnd-glosa-literal",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821421,
    "uid": "etim-v2-fnd-definicao-clinica",
    "Text": "O uso médico vigente, não só os morfemas, determina a {{c1::definição clínica}}.",
    "Extra": "Termos históricos podem desviar do sentido literal.",
    "tags": [
      "etim_uid::etim-v2-fnd-definicao-clinica",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821427,
    "uid": "etim-v2-fnd-ponte-ph-f",
    "Text": "Em português, <b>phleb/o</b> corresponde a {{c1::fleb/o}}.",
    "Extra": "Assim, phlebitis corresponde a flebite.",
    "tags": [
      "etim_uid::etim-v2-fnd-ponte-ph-f",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821433,
    "uid": "etim-v2-fnd-ponte-th-t",
    "Text": "Em português, <b>thorac/o</b> corresponde a {{c1::torac/o}}.",
    "Extra": "Assim, thoracotomy corresponde a toracotomia.",
    "tags": [
      "etim_uid::etim-v2-fnd-ponte-th-t",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821438,
    "uid": "etim-v2-fnd-ponte-y-i",
    "Text": "Em português, <b>glyc/o</b> corresponde a {{c1::glic/o}}.",
    "Extra": "Assim, glycemia corresponde a glicemia.",
    "tags": [
      "etim_uid::etim-v2-fnd-ponte-y-i",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821445,
    "uid": "etim-v2-fnd-ponte-rh-r",
    "Text": "Em português, <b>rhino-</b> corresponde a {{c1::rino-}}.",
    "Extra": "Assim, rhinitis corresponde a rinite.",
    "tags": [
      "etim_uid::etim-v2-fnd-ponte-rh-r",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::fundamento"
    ]
  },
  {
    "noteId": 1784291821449,
    "uid": "etim-v2-pre-a-an",
    "Text": "O prefixo <b>a-/an-</b> indica {{c1::ausência ou negação}}.",
    "Extra": "Ex.: anóxia; referente a ausência ou negação.",
    "tags": [
      "etim_uid::etim-v2-pre-a-an",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821456,
    "uid": "etim-v2-pre-endo",
    "Text": "O prefixo <b>endo-</b> indica {{c1::interno}}.",
    "Extra": "Ex.: endocárdio; referente a interno.",
    "tags": [
      "etim_uid::etim-v2-pre-endo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821462,
    "uid": "etim-v2-pre-epi",
    "Text": "O prefixo <b>epi-</b> indica {{c1::sobre}}.",
    "Extra": "Ex.: epiderme; referente a sobre.",
    "tags": [
      "etim_uid::etim-v2-pre-epi",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821466,
    "uid": "etim-v2-pre-exo",
    "Text": "O prefixo <b>exo-</b> indica {{c1::externo}}.",
    "Extra": "Ex.: exocitose; referente a externo.",
    "tags": [
      "etim_uid::etim-v2-pre-exo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821474,
    "uid": "etim-v2-pre-inter",
    "Text": "O prefixo <b>inter-</b> indica {{c1::entre}}.",
    "Extra": "Ex.: intercostal; referente a entre.",
    "tags": [
      "etim_uid::etim-v2-pre-inter",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821481,
    "uid": "etim-v2-pre-intra",
    "Text": "O prefixo <b>intra-</b> indica {{c1::dentro}}.",
    "Extra": "Ex.: intracelular; referente a dentro.",
    "tags": [
      "etim_uid::etim-v2-pre-intra",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821487,
    "uid": "etim-v2-pre-peri",
    "Text": "O prefixo <b>peri-</b> indica {{c1::ao redor}}.",
    "Extra": "Ex.: pericárdio; referente a ao redor.",
    "tags": [
      "etim_uid::etim-v2-pre-peri",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821493,
    "uid": "etim-v2-pre-sub",
    "Text": "O prefixo <b>sub-</b> indica {{c1::abaixo}}.",
    "Extra": "Ex.: subcutâneo; referente a abaixo.",
    "tags": [
      "etim_uid::etim-v2-pre-sub",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821498,
    "uid": "etim-v2-pre-trans",
    "Text": "O prefixo <b>trans-</b> indica {{c1::através}}.",
    "Extra": "Ex.: transdérmico; referente a através.",
    "tags": [
      "etim_uid::etim-v2-pre-trans",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821502,
    "uid": "etim-v2-pre-poli",
    "Text": "O prefixo <b>poli-</b> indica {{c1::muitos}}.",
    "Extra": "Ex.: poliúria; referente a muitos.",
    "tags": [
      "etim_uid::etim-v2-pre-poli",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821508,
    "uid": "etim-v2-pre-oligo",
    "Text": "O prefixo <b>oligo-</b> indica {{c1::poucos}}.",
    "Extra": "Ex.: oligúria; referente a poucos.",
    "tags": [
      "etim_uid::etim-v2-pre-oligo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821514,
    "uid": "etim-v2-pre-pan",
    "Text": "O prefixo <b>pan-</b> indica {{c1::todo}}.",
    "Extra": "Ex.: pancitopenia; referente a todo.",
    "tags": [
      "etim_uid::etim-v2-pre-pan",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821521,
    "uid": "etim-v2-pre-hiper",
    "Text": "O prefixo <b>hiper-</b> indica {{c1::excesso ou acima}}.",
    "Extra": "Ex.: hiperglicemia; referente a excesso ou acima.",
    "tags": [
      "etim_uid::etim-v2-pre-hiper",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821527,
    "uid": "etim-v2-pre-hipo",
    "Text": "O prefixo <b>hipo-</b> indica {{c1::deficiência ou abaixo}}.",
    "Extra": "Ex.: hipoglicemia; referente a deficiência ou abaixo.",
    "tags": [
      "etim_uid::etim-v2-pre-hipo",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821532,
    "uid": "etim-v2-pre-bradi",
    "Text": "O prefixo <b>bradi-</b> indica {{c1::lento}}.",
    "Extra": "Ex.: bradicardia; referente a lento.",
    "tags": [
      "etim_uid::etim-v2-pre-bradi",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821538,
    "uid": "etim-v2-pre-taqui",
    "Text": "O prefixo <b>taqui-</b> indica {{c1::rápido}}.",
    "Extra": "Ex.: taquipneia; referente a rápido.",
    "tags": [
      "etim_uid::etim-v2-pre-taqui",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::prefixo"
    ]
  },
  {
    "noteId": 1784291821544,
    "uid": "etim-v2-suf-ite",
    "Text": "O sufixo <b>-ite</b> indica {{c1::inflamação}}.",
    "Extra": "Ex.: gastrite; referente a inflamação.",
    "tags": [
      "etim_uid::etim-v2-suf-ite",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821549,
    "uid": "etim-v2-suf-penia",
    "Text": "O sufixo <b>-penia</b> indica {{c1::redução numérica}}.",
    "Extra": "Ex.: leucopenia; referente a redução numérica.",
    "tags": [
      "etim_uid::etim-v2-suf-penia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821556,
    "uid": "etim-v2-suf-megalia",
    "Text": "O sufixo <b>-megalia</b> indica {{c1::aumento}}.",
    "Extra": "Ex.: hepatomegalia; referente a aumento.",
    "tags": [
      "etim_uid::etim-v2-suf-megalia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821562,
    "uid": "etim-v2-suf-plasia",
    "Text": "O sufixo <b>-plasia</b> indica {{c1::formação ou crescimento}}.",
    "Extra": "Ex.: hiperplasia; referente a formação ou crescimento.",
    "tags": [
      "etim_uid::etim-v2-suf-plasia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821567,
    "uid": "etim-v2-suf-trofia",
    "Text": "O sufixo <b>-trofia</b> indica {{c1::nutrição ou tamanho}}.",
    "Extra": "Ex.: hipertrofia; referente a nutrição ou tamanho.",
    "tags": [
      "etim_uid::etim-v2-suf-trofia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821573,
    "uid": "etim-v2-suf-dipsia",
    "Text": "O sufixo <b>-dipsia</b> indica {{c1::sede}}.",
    "Extra": "Ex.: polidipsia; referente a sede.",
    "tags": [
      "etim_uid::etim-v2-suf-dipsia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821579,
    "uid": "etim-v2-suf-pneia",
    "Text": "O sufixo <b>-pneia</b> indica {{c1::respiração}}.",
    "Extra": "Ex.: taquipneia; referente a respiração.",
    "tags": [
      "etim_uid::etim-v2-suf-pneia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821585,
    "uid": "etim-v2-suf-rreia",
    "Text": "O sufixo <b>-rreia</b> indica {{c1::fluxo ou secreção}}.",
    "Extra": "Ex.: diarreia; referente a fluxo ou secreção.",
    "tags": [
      "etim_uid::etim-v2-suf-rreia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821591,
    "uid": "etim-v2-suf-capnia",
    "Text": "O sufixo <b>-capnia</b> indica {{c1::dióxido de carbono}}.",
    "Extra": "Ex.: hipercapnia; referente a dióxido de carbono.",
    "tags": [
      "etim_uid::etim-v2-suf-capnia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821596,
    "uid": "etim-v2-suf-iase",
    "Text": "O sufixo <b>-íase</b> indica {{c1::condição ou formação}}.",
    "Extra": "Ex.: litíase; referente a condição ou formação.",
    "tags": [
      "etim_uid::etim-v2-suf-iase",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821603,
    "uid": "etim-v2-suf-ectomia",
    "Text": "O sufixo <b>-ectomia</b> indica {{c1::remoção cirúrgica}}.",
    "Extra": "Ex.: gastrectomia; referente a remoção cirúrgica.",
    "tags": [
      "etim_uid::etim-v2-suf-ectomia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821608,
    "uid": "etim-v2-suf-tomia",
    "Text": "O sufixo <b>-tomia</b> indica {{c1::incisão}}.",
    "Extra": "Ex.: laparotomia; referente a incisão.",
    "tags": [
      "etim_uid::etim-v2-suf-tomia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821614,
    "uid": "etim-v2-suf-stomia",
    "Text": "O sufixo <b>-stomia</b> indica {{c1::criação de abertura}}.",
    "Extra": "Ex.: colostomia; referente a criação de abertura.",
    "tags": [
      "etim_uid::etim-v2-suf-stomia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::sufixo"
    ]
  },
  {
    "noteId": 1784291821618,
