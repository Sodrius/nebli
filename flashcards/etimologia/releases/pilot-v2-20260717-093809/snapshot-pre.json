  {
    "noteId": 1784291821846,
    "uid": "etim-v2-con-001-hiperplasia-hipertrofia",
    "Text": "<b>hiperplasia</b> aponta para {{c1::número celular}}; <b>hipertrofia</b>, para {{c2::tamanho celular}}.",
    "Extra": "Hiperplasia conta células; hipertrofia aumenta cada célula.",
    "tags": [
      "etim_uid::etim-v2-con-001-hiperplasia-hipertrofia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::contraste"
    ]
  },
  {
    "noteId": 1784291821854,
    "uid": "etim-v2-con-002-tomia-ectomia",
    "Text": "<b>-tomia</b> aponta para {{c1::incisão}}; <b>-ectomia</b>, para {{c2::remoção cirúrgica}}.",
    "Extra": "-tomia corta; -ectomia retira parte ou toda estrutura.",
    "tags": [
      "etim_uid::etim-v2-con-002-tomia-ectomia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::contraste"
    ]
  },
  {
    "noteId": 1784291821862,
    "uid": "etim-v2-con-003-stomia-tomia",
    "Text": "<b>-stomia</b> aponta para {{c1::abertura cirúrgica}}; <b>-tomia</b>, para {{c2::incisão}}.",
    "Extra": "-stomia cria comunicação; -tomia apenas incisa.",
    "tags": [
      "etim_uid::etim-v2-con-003-stomia-tomia",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::contraste"
    ]
  },
  {
    "noteId": 1784291821868,
    "uid": "etim-v2-con-004-grafia-grama",
    "Text": "<b>-grafia</b> aponta para {{c1::processo de registro}}; <b>-grama</b>, para {{c2::registro produzido}}.",
    "Extra": "-grafia é o exame; -grama, seu produto.",
    "tags": [
      "etim_uid::etim-v2-con-004-grafia-grama",
      "etim_v2",
      "terminologia::nivel::nucleo",
      "terminologia::tipo::contraste"
    ]
  },
  {
    "noteId": 1784291821875,
    "uid": "etim-v2-con-005-metro-metria",
    "Text": "<b>-metro</b> aponta para {{c1::instrumento}}; <b>-metria</b>, para {{c2::medição}}.",
