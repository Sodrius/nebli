{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEBLI Etimologia source card",
  "type": "object",
  "required": ["uid", "deck", "kind", "text", "extra", "source_etymology", "source_medical", "status"],
  "properties": {
    "uid": {"type": "string", "pattern": "^etim-[a-z0-9-]+$"},
    "deck": {"type": "string", "pattern": "^NEBLI::Etimologia::"},
    "kind": {"enum": ["foundation", "morpheme_in_context", "term_decomposition", "contrast", "exception", "transfer"]},
    "term_en": {"type": "string"},
    "term_ptbr": {"type": "string"},
    "canonical_form": {"type": "string"},
    "origin_language": {"enum": ["Greek", "Latin", "Hybrid", "Other", "Not_applicable"]},
    "morpheme_breakdown": {"type": "string"},
    "literal_gloss": {"type": "string"},
    "clinical_meaning": {"type": "string"},
    "inference_limit": {"type": "string"},
    "variants": {"type": "array", "items": {"type": "string"}},
    "text": {"type": "string", "pattern": "\\{\\{c1::"},
    "extra": {"type": "string"},
    "source_etymology": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_medical": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "license": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "linguistic_review", "medical_review", "approved", "retired"]}
  },
  "additionalProperties": false
}
